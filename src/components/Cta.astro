---
import { site } from "../content/site";

const { cta } = site;
---

<section class="section cta" id="contato" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__panel">
      <h2 class="cta__title" id="cta-title">{cta.title}</h2>
      <p class="cta__text">{cta.text}</p>
      <a class="btn" href={cta.buttonHref}>{cta.buttonLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    max-width: 38rem;
    padding: clamp(1.5rem, 4vw, 2.4rem);
    border-radius: 1.25rem;
    background:
      linear-gradient(145deg, #dff0e6 0%, #edf4f0 55%, #f7faf8 100%);
    border: 1px solid var(--color-accent-soft);
  }

  .cta__title {
    margin-bottom: 0.75rem;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
  }

  .cta__text {
    color: var(--color-ink-muted);
    margin-bottom: 1.35rem;
  }
</style>
